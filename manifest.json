{
  "manifest_version": 3,
  "name": "Priority Scorer",
  "version": "1.0.0",
  "description": "Score & rank Jira and Linear tickets with RICE and ICE. All data stays in your browser — no accounts, no servers.",
  "homepage_url": "https://github.com/berkbuldanli/inline-prioritization-extension",

  "permissions": ["storage", "clipboardWrite"],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Priority Scorer",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },

  "content_scripts": [
    {
      "matches": [
        "*://*.atlassian.net/*",
        "*://linear.app/*"
      ],
      "js": [
        "lib/storage.js",
        "lib/scoring.js",
        "lib/scoreForm.js",
        "content/content.js"
      ],
      "css": ["lib/scoreForm.css", "content/widget.css"],
      "run_at": "document_idle"
    }
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "priority-scorer@example.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
